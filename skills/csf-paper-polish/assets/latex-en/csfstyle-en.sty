% =========================================================================== %
% csfstyle-en.sty —— Neutral English top-venue shell
%
% WHY THIS FILE EXISTS
% --------------------
% The earlier stack wrote Chinese first inside `cumcmthesis.cls` and translated
% afterwards. Two independent defects followed; only the second is a translation
% problem, and fixing only that one would have changed almost nothing visible:
%
%   (1) CLASS-LEVEL (the dominant cause of "the appearance is poor").
%       cumcmthesis.cls is a Chinese contest template: SimSun body, 1.5 line
%       spacing, two-character first-line indent, wide white space, and a
%       "Problem Restatement / Assumptions / Notation" front matter. No amount of
%       good English inside that class looks like a top-venue paper, because the
%       measure, leading, paragraph style, heading case, caption style and front
%       matter are all contest-flavoured.
%   (2) RHETORIC-LEVEL. Chinese contest prose is evaluative and
%       nominalisation-heavy ("有效提升了…具有重要意义"). Rendered literally it
%       becomes agentless passive plus "firstly/secondly/finally" plus
%       unsupported adjectives, which a reviewer discounts within one paragraph.
%
% This shell fixes (1) by construction. (2) is handled by
% `references/english-narrative.md` and `scripts/csf_prose.py`.
%
% PROVENANCE OF THE VENUE PRESETS — read this before editing any number below.
%   Every parameter in the `neurips`, `icml` and `aaai` presets was copied from the
%   OFFICIAL style file, which is vendored in this repo and can be re-read:
%     _vendor/venue-styles/neurips/_raw/neurips_2025.sty
%     _vendor/venue-styles/icml/_raw/icml2025.sty
%     _vendor/venue-styles/aaai/_raw/CameraReady/LaTeX/aaai25.sty
%   Each preset cites the defining line numbers. `aamas` is an acmart/sigconf
%   approximation because the official AAMAS kit was unreachable (Cloudflare 403);
%   `nature` and `elsevier` are stylised, because neither venue publishes a
%   general LaTeX class. See `references/venue-style-specs.md` for the full table,
%   the verification ledger and the venues that could NOT be verified.
%
%   This shell remains an AUTHORING tool, not a compliance check. Official classes
%   impose constraints a competition report does not want (anonymisation, page
%   limits, mandatory checklists, and in AAAI's case \PackageError on 16 packages
%   including geometry and hyperref). For an actual submission, use the official
%   class from `_vendor/venue-styles/`.
%
% USAGE
%   \documentclass[10pt]{article}          % add `twocolumn` for icml/aaai/aamas
%   \usepackage[neurips,stix,final]{csfstyle-en}
%
% OPTIONS
%   venue : neurips (default) | icml | aaai | aamas | nature | elsevier
%   fonts : stix (default) | times | libertinus | charter
%   mode  : final (default) | draft   (draft = line numbers + visible claim tags)
%   print :                            (black links instead of dark blue)
%   boxes :                            (soft tinted fills; default is plain rules)
%
% ENGINE
%   LuaLaTeX strongly preferred: microtype font EXPANSION is unavailable under
%   XeLaTeX, and expansion is the larger half of microtype's benefit. The shell
%   still compiles under XeLaTeX, with a warning and no expansion.
% =========================================================================== %
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{csfstyle-en}[2026/02/06 v1.1 English top-venue shell, values verified against official .sty files]

% --------------------------------------------------------------------------- %
% Options. Parsed BEFORE packages load, so geometry and fonts are configured
% once and cannot be half-overridden later.
% --------------------------------------------------------------------------- %
\def\csf@venue{neurips}
\def\csf@fontset{stix}
\newif\ifcsf@print
\newif\ifcsf@tinted
\newif\ifcsf@draft
\csf@printfalse
\csf@tintedfalse
\csf@draftfalse

\DeclareOption{neurips}{\def\csf@venue{neurips}}
\DeclareOption{icml}{\def\csf@venue{icml}}
\DeclareOption{aaai}{\def\csf@venue{aaai}}
\DeclareOption{aamas}{\def\csf@venue{aamas}}
\DeclareOption{nature}{\def\csf@venue{nature}}
\DeclareOption{elsevier}{\def\csf@venue{elsevier}}
\DeclareOption{stix}{\def\csf@fontset{stix}}
\DeclareOption{times}{\def\csf@fontset{times}}
\DeclareOption{libertinus}{\def\csf@fontset{libertinus}}
\DeclareOption{charter}{\def\csf@fontset{charter}}
\DeclareOption{draft}{\csf@drafttrue}
\DeclareOption{final}{\csf@draftfalse}
\DeclareOption{print}{\csf@printtrue}
\DeclareOption{boxes}{\csf@tintedtrue}
\DeclareOption*{\PackageWarning{csfstyle-en}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

% --------------------------------------------------------------------------- %
% Engine gate. An explicit early error beats a downstream fontspec explosion.
% --------------------------------------------------------------------------- %
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{csfstyle-en}{XeLaTeX or LuaLaTeX required}%
    {This shell loads real OTF text and math fonts through fontspec.\MessageBreak
     Compile with `lualatex paper.tex` (preferred) or `xelatex paper.tex`.\MessageBreak
     pdfLaTeX cannot load STIX Two / Libertinus and would silently fall back to\MessageBreak
     Computer Modern, which is the opposite of the intended appearance.}%
\fi

% --------------------------------------------------------------------------- %
% Mathematics.
%
% LOAD ORDER MATTERS: mathtools must be loaded BEFORE unicode-math, otherwise it
% warns "For best results, please load mathtools *before* unicode-math" and some
% multi-line constructs are built against the wrong math setup.
%
% NOTE: amssymb is deliberately NOT loaded. unicode-math already defines every
% AMS symbol, and loading amssymb afterwards aborts with
%   "Command `\eth' already defined."
% That failure is a known unicode-math interaction, not a font problem.
% --------------------------------------------------------------------------- %
\RequirePackage{amsmath}
\RequirePackage{mathtools}

% --------------------------------------------------------------------------- %
% Fonts.
%
% Files are referenced by FILENAME on purpose. MiKTeX ships these OTFs but does
% not register them with the Windows font database, so family-name lookup
% (`\setmainfont{Libertinus Serif}`) is unreliable, while filenames always
% resolve through kpathsea. Only genuinely installed system fonts (Times New
% Roman) are addressed by name.
%
%   stix       STIX Two Text + STIX Two Math. A scholarly superfamily that is
%              metric-compatible with Times AND ships a matched math font. The
%              default, because text/math harmony is the most visible single cue
%              that a paper was typeset rather than word-processed.
%   times      Times New Roman body — what NeurIPS and ICML actually mandate
%              (neurips_2025.sty:92 `\renewcommand{\rmdefault}{ptm}`) — with STIX
%              Two Math, which shares Times metrics.
%   libertinus Libertinus Serif + Libertinus Math. Also what ACM acmart uses.
%   charter    XCharter + XCharter Math; large x-height, legible at two-column 9-10pt.
%
% The definitions are DECLARED here and INVOKED after unicode-math exists.
% --------------------------------------------------------------------------- %
\RequirePackage{fontspec}

\def\csf@loadfonts@stix{%
  \setmainfont{STIXTwoText-Regular.otf}[
    BoldFont       = STIXTwoText-Bold.otf,
    ItalicFont     = STIXTwoText-Italic.otf,
    BoldItalicFont = STIXTwoText-BoldItalic.otf,
    Ligatures      = TeX, Numbers = Lining,
    SlantedFont    = STIXTwoText-Italic.otf,
    BoldSlantedFont= STIXTwoText-BoldItalic.otf,
  ]%
  \setsansfont{libertinussans-regular.otf}[
    BoldFont   = libertinussans-bold.otf,
    ItalicFont = libertinussans-italic.otf, Ligatures = TeX,
  ]%
  \setmonofont{texgyrecursor-regular.otf}[
    BoldFont = texgyrecursor-bold.otf, Scale = 0.90,
  ]%
  \setmathfont{STIXTwoMath-Regular.otf}%
}

\def\csf@loadfonts@times{%
  \setmainfont{Times New Roman}[Ligatures=TeX,
    SlantedFont     = timesi.ttf,
    BoldSlantedFont = timesbi.ttf]%
  \setsansfont{libertinussans-regular.otf}[
    BoldFont   = libertinussans-bold.otf,
    ItalicFont = libertinussans-italic.otf,
  ]%
  \setmonofont{texgyrecursor-regular.otf}[
    BoldFont = texgyrecursor-bold.otf, Scale = 0.90,
  ]%
  \setmathfont{STIXTwoMath-Regular.otf}%
}

\def\csf@loadfonts@libertinus{%
  \setmainfont{libertinusserif-regular.otf}[
    BoldFont       = libertinusserif-bold.otf,
    ItalicFont     = libertinusserif-italic.otf,
    BoldItalicFont = libertinusserif-bolditalic.otf, Ligatures = TeX,
    SlantedFont    = libertinusserif-italic.otf,
    BoldSlantedFont= libertinusserif-bolditalic.otf,
  ]%
  \setsansfont{libertinussans-regular.otf}[
    BoldFont   = libertinussans-bold.otf,
    ItalicFont = libertinussans-italic.otf,
  ]%
  \setmonofont{libertinusmono-regular.otf}[Scale=0.90]%
  \setmathfont{libertinusmath-regular.otf}%
}

\def\csf@loadfonts@charter{%
  \setmainfont{XCharter-Roman.otf}[
    BoldFont       = XCharter-Bold.otf,
    ItalicFont     = XCharter-Italic.otf,
    BoldItalicFont = XCharter-BoldItalic.otf, Ligatures = TeX,
    SlantedFont    = XCharter-Italic.otf,
    BoldSlantedFont= XCharter-BoldItalic.otf,
  ]%
  \setsansfont{libertinussans-regular.otf}[
    BoldFont   = libertinussans-bold.otf,
    ItalicFont = libertinussans-italic.otf,
  ]%
  \setmonofont{texgyrecursor-regular.otf}[Scale=0.90]%
  \setmathfont{XCharter-Math.otf}%
}

\RequirePackage{unicode-math}
% Dispatch through \csname rather than a conditional. \IfFileExists-style
% conditionals read whole branches with \reserved@a and therefore mis-handle any
% parameter token inside them; that defect produced three separate
% "Illegal parameter number" failures in the Chinese csfstyle.sty. An exact
% \csname expansion has no such failure mode.
\csname csf@loadfonts@\csf@fontset\endcsname

% --------------------------------------------------------------------------- %
% SHAPE DOCTOR — catches silent font-shape substitution.
%
% WHY THIS EXISTS. The ICML preset asks for a SLANTED caption label (`\slshape`,
% copied from icml2025.sty:715 `\sbox{\newcaptionbox}{\small\sl #1.~}`). The first
% build of this shell produced an upright label and NOTHING reported a problem:
% STIX Two Text ships no slanted shape, so fontspec silently resolved `\slshape`
% to the upright font. The defect was only found by rendering the page at 260 dpi
% and comparing `\textsl{...}` with `\textup{...}` by eye — the two were
% pixel-identical.
%
% This is the same failure mode as the CJK tofu problem elsewhere in this repo: a
% font request that cannot be satisfied degrades silently instead of erroring. The
% fix has two halves, and both are needed:
%   1. declare SlantedFont/BoldSlantedFont in every font set above, so `\slshape`
%      has something to resolve to;
%   2. run this check at \begin{document} so that if a font set is ever changed and
%      the shape stops resolving, the build SAYS SO instead of quietly producing
%      upright text.
%
% The test compares the actual font identifier (`\the\font`) selected by each shape
% against the upright one. Equal identifiers mean the shape did not change the
% font, which for a declared shape is always a defect and never a real design.
%
% The definitions MUST be \xdef (global). The first version used \edef inside
% \begingroup...\endgroup, so both macros died at \endgroup, \ifx then compared two
% undefined macros, and the guard reported EVERY shape as broken — including
% \bfseries and \itshape, which demonstrably work. A guard that always fires is
% worse than no guard, so the fix is paired with the two-way test recorded in
% references/latex-workflow.md.
% --------------------------------------------------------------------------- %
\def\csf@shapefont#1{\begingroup#1\xdef\csf@tmpa{\the\font}\endgroup}
\def\csf@checkshape#1#2{%
  \begingroup\xdef\csf@tmpup{\the\font}\endgroup
  \csf@shapefont{#1}%
  \ifx\csf@tmpa\csf@tmpup
    \PackageWarning{csfstyle-en}{Shape `#2' resolves to the SAME font as upright.
      The selected font set (\csf@fontset) cannot satisfy this shape, so the
      output is silently UPRIGHT where a distinct shape was requested. Declare
      the matching font file in \string\csf@loadfonts@\csf@fontset, or stop using
      this shape in the text}%
  \fi}
\AtBeginDocument{%
  \csf@checkshape{\itshape}{itshape}%
  \csf@checkshape{\slshape}{slshape}%
  \csf@checkshape{\bfseries}{bfseries}%
  \csf@checkshape{\scshape}{scshape}%
}

% Semantic operators, declared once so the prose never fakes them with italic
% text (a reliable tell in contest drafts: "argmin" set as five italic letters).
\providecommand{\argmin}{\operatorname*{arg\,min}}
\providecommand{\argmax}{\operatorname*{arg\,max}}
\providecommand{\Expect}{\mathbb{E}}
\providecommand{\Prob}{\mathbb{P}}
\providecommand{\Var}{\operatorname{Var}}
\providecommand{\Cov}{\operatorname{Cov}}
\providecommand{\Corr}{\operatorname{Corr}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\ind}[1]{\mathbb{I}\!\left[#1\right]}
\providecommand{\set}[1]{\left\{#1\right\}}
\providecommand{\abs}[1]{\left\lvert#1\right\rvert}
\providecommand{\norm}[1]{\left\lVert#1\right\rVert}
% Conditional probability with correct spacing: \Prob(x \given y). A bare `|` is a
% relation and receives relation spacing, which reads as a typo.
\providecommand{\given}{\;\middle|\;}

