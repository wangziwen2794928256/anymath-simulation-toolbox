% --------------------------------------------------------------------------- %
% VENUE PRESETS — VALUE DEFINITIONS ONLY. Nothing is applied here; the single
% "apply" section further down consumes these values. Keeping definition and
% application apart is what allows the values to be checked line-by-line against
% the official files without also having to trace a chain of side effects.
%
% Values marked [official] were copied from the vendored official style file and
% the defining line is cited. Values marked [approx] are the cross-venue common
% denominator where the official file does not define the parameter.
% --------------------------------------------------------------------------- %
\RequirePackage{geometry}

\def\csf@venue@neurips{%
  % [official] neurips_2025.sty:117-124 — SINGLE column: textwidth 5.5in on
  % letterpaper leaves a 1.5in margin on each side. A 5.5in measure at 10pt holds
  % ~66 characters, the readable optimum.
  \def\csf@geometry{letterpaper,textwidth=5.5in,textheight=9in,top=1in,%
                    headheight=12pt,headsep=25pt,footskip=30pt}%
  \def\csf@twocolreq{0}%
  % [official] :155-157 `\large`=12/14pt, `\Large`=14/16pt, `\LARGE`=17/20pt
  % [official] :311 title is `\LARGE\bf`, centred between two rules (:290-300)
  \def\csf@titlefmt{\LARGE\bfseries}%
  \def\csf@titlebars{1}%
  \def\csf@authorfmt{\bfseries}%
  % [official] :163-182 section `\large\bf\raggedright`, subsection and
  % subsubsection both `\normalsize\bf\raggedright`
  \def\csf@secfmt{\large\bfseries\raggedright}%
  \def\csf@subsecfmt{\normalsize\bfseries\raggedright}%
  \def\csf@subsubfmt{\normalsize\bfseries\raggedright}%
  \def\csf@secbefore{-2.0ex plus -0.5ex minus -0.2ex}%
  \def\csf@secafter{1.5ex plus 0.3ex minus 0.2ex}%
  \def\csf@subbefore{-1.8ex plus -0.5ex minus -0.2ex}%
  \def\csf@subafter{0.8ex plus 0.2ex}%
  \def\csf@subsubbefore{-1.5ex plus -0.5ex minus -0.2ex}%
  \def\csf@subsubafter{0.5ex plus 0.2ex}%
  % [official] :228-229 BLOCK paragraphs. This is a real style signature of the
  % AI conferences and it is invisible until you see the two styles side by side:
  % no first-line indent, and a visible 5.5pt gap between paragraphs.
  \def\csf@parindent{0pt}%
  \def\csf@parskip{5.5pt}%
  % [official] :132 flushbottom, not raggedbottom
  \def\csf@bottom{\flushbottom}%
  \def\csf@secdepth{3}%
  % [official] :203-206
  \def\csf@topfraction{0.85}%
  \def\csf@bottomfraction{0.4}%
  % [approx] neurips_2025.sty does not configure the caption package at all, so
  % the shell uses the modern cross-venue convention: bold label, period, 9pt.
  \def\csf@captionlabelformat{csfperiod}%
  \def\csf@labelemph{\bfseries}%
  \def\csf@captionfont{small}%
  \def\csf@captionlabelfontsize{\small}%
  \def\csf@captionjust{justified}%
  \def\csf@captioncenter{0}%
  % [official] :346-357 abstract is `\centerline{\large\bf Abstract}` followed by
  % a `quote`, i.e. the abstract body stays at NORMAL size and is narrowed by the
  % quote indentation. Setting it to \small (as an earlier version did) both
  % lightens it and diverges from the official look.
  \def\csf@abstractheadfmt{\large\bfseries}%
  \def\csf@abstractsize{\normalsize}%
  \def\csf@abstractquote{1}%
  \def\csf@listmargin{3pc}%
}

\def\csf@venue@icml{%
  % [official] icml2025.sty:220-222 — TWO columns: textwidth 6.75in,
  % columnsep 0.25in, textheight 9in. icml2025.sty:326 `\flushbottom \twocolumn`.
  \def\csf@geometry{letterpaper,textwidth=6.75in,columnsep=0.25in,%
                    textheight=9in,top=1in}%
  \def\csf@twocolreq{1}%
  % [official] :418 title is `\Large\bf` between top/bottom title bars
  \def\csf@titlefmt{\Large\bfseries}%
  \def\csf@titlebars{0}%
  \def\csf@authorfmt{\bfseries}%
  % [official] :641-646. NOTE subsubsection is `\sc` (small caps), not italic —
  % a small detail that instantly distinguishes ICML-styled output.
  \def\csf@secfmt{\large\bfseries\raggedright}%
  \def\csf@subsecfmt{\normalsize\bfseries\raggedright}%
  \def\csf@subsubfmt{\normalsize\scshape\raggedright}%
  \def\csf@secbefore{-0.12in}%
  \def\csf@secafter{0.02in}%
  \def\csf@subbefore{-0.10in}%
  \def\csf@subafter{0.01in}%
  \def\csf@subsubbefore{-0.08in}%
  \def\csf@subsubafter{0.01in}%
  % [official] :659-664 BLOCK paragraphs, 6pt gap
  \def\csf@parindent{0pt}%
  \def\csf@parskip{6pt}%
  \def\csf@bottom{\flushbottom}%
  \def\csf@secdepth{3}%
  \def\csf@topfraction{0.85}%
  \def\csf@bottomfraction{0.4}%
  % [official] :715-720 caption label is `\small\sl` (SLANTED, not bold) with a
  % period; short captions are centred; long-caption body text is \footnotesize.
  \def\csf@captionlabelformat{csfperiod}%
  \def\csf@labelemph{\slshape}%
  \def\csf@captionfont{footnotesize}%
  \def\csf@captionlabelfontsize{\small}%
  \def\csf@captionjust{justified}%
  \def\csf@captioncenter{1}%
  % [official] :580-586 abstract heading `\large\bf` + quote, body normal size
  \def\csf@abstractheadfmt{\large\bfseries}%
  \def\csf@abstractsize{\normalsize}%
  \def\csf@abstractquote{1}%
  \def\csf@listmargin{2em}%
}

\def\csf@venue@aaai{%
  % [official] aaai25.sty:35-41 — TWO columns: textwidth 7.0in, columnsep
  % 0.375in, textheight 9in, `\flushbottom \twocolumn \sloppy`.
  \def\csf@geometry{letterpaper,textwidth=7.0in,columnsep=0.375in,%
                    textheight=9in,top=0.75in}%
  \def\csf@twocolreq{1}%
  \def\csf@titlefmt{\LARGE\bfseries}%
  \def\csf@titlebars{0}%
  \def\csf@authorfmt{\bfseries}%
  % [official] :163-173 section is `\Large\bf\centering` AND
  % `\setcounter{secnumdepth}{0}` — AAAI centres its headings and turns numbering
  % OFF. This is the most visible divergence between the AI venues, so the shell
  % must not force its own numbering on it.
  \def\csf@secfmt{\Large\bfseries\centering}%
  \def\csf@subsecfmt{\large\bfseries\centering}%
  \def\csf@subsubfmt{\normalsize\bfseries\centering}%
  \def\csf@secbefore{-2.0ex plus -0.5ex minus -0.2ex}%
  \def\csf@secafter{3pt plus 2pt minus 1pt}%
  \def\csf@subbefore{-2.0ex plus -0.5ex minus -0.2ex}%
  \def\csf@subafter{2pt plus 1pt}%
  \def\csf@subsubbefore{-6pt plus -2pt minus -1pt}%
  \def\csf@subsubafter{1pt}%
  % [official] :147,185 parskip 2pt and parindent 10pt — AAAI INDENTS, unlike
  % NeurIPS and ICML. Do not "tidy" this into consistency: the differences are real.
  \def\csf@parindent{10pt}%
  \def\csf@parskip{2pt}%
  \def\csf@bottom{\flushbottom}%
  \def\csf@secdepth{0}%   [official] :173 secnumdepth = 0
  \def\csf@topfraction{0.85}%
  \def\csf@bottomfraction{0.4}%
  % [approx] AAAI's instructions set captions in 10pt roman and state explicitly
  % that they are NOT bold or italic, which no other venue in scope does.
  \def\csf@captionlabelformat{csfperiod}%
  \def\csf@labelemph{\mdseries}%
  \def\csf@captionfont{normalsize}%
  \def\csf@captionlabelfontsize{\normalsize}%
  \def\csf@captionjust{justified}%
  \def\csf@captioncenter{0}%
  \def\csf@abstractheadfmt{\large\bfseries}%
  \def\csf@abstractsize{\normalsize}%
  \def\csf@abstractquote{1}%
  \def\csf@listmargin{2em}%
}

\def\csf@venue@aamas{%
  % [approx, UNVERIFIED against the official 2025 kit] The official AAMAS kit was
  % unreachable (Cloudflare 403 on every path). Values below come from the
  % vendored third-party aamas.cls, which is an acmart/amsart fork using
  % format=sigconf: `columnsep=2pc` (aamas.cls:507) and `parindent 10pt` (:542).
  \def\csf@geometry{letterpaper,textwidth=7.03in,columnsep=2pc,%
                    textheight=9.39in,top=0.75in}%
  \def\csf@twocolreq{1}%
  \def\csf@titlefmt{\Large\bfseries}%
  \def\csf@titlebars{0}%
  \def\csf@authorfmt{\bfseries}%
  % ACM sigconf sets subsection to the SAME size as section (:e.g. acmart sigconf)
  \def\csf@secfmt{\Large\bfseries\raggedright}%
  \def\csf@subsecfmt{\large\bfseries\raggedright}%
  \def\csf@subsubfmt{\normalsize\bfseries\raggedright}%
  \def\csf@secbefore{-2.0ex plus -0.5ex minus -0.2ex}%
  \def\csf@secafter{2pt plus 1pt}%
  \def\csf@subbefore{-1.8ex plus -0.5ex minus -0.2ex}%
  \def\csf@subafter{1pt}%
  \def\csf@subsubbefore{-1.5ex plus -0.5ex minus -0.2ex}%
  \def\csf@subsubafter{1pt}%
  \def\csf@parindent{10pt}%   [official] aamas.cls:542
  \def\csf@parskip{0pt}%
  \def\csf@bottom{\flushbottom}%
  \def\csf@secdepth{3}%
  \def\csf@topfraction{0.85}%
  \def\csf@bottomfraction{0.4}%
  % [official-adjacent] aamas.cls / acmart use `labelsep=colon` with a bold label
  % and bold caption text. The colon form is the ACM house style.
  \def\csf@captionlabelformat{csfcolon}%
  \def\csf@labelemph{\bfseries}%
  \def\csf@captionfont{small}%
  \def\csf@captionlabelfontsize{\small}%
  \def\csf@captionjust{raggedright}%
  \def\csf@captioncenter{0}%
  \def\csf@abstractheadfmt{\large\bfseries}%
  \def\csf@abstractsize{\small}%
  \def\csf@abstractquote{1}%
  \def\csf@listmargin{1.5em}%
}

