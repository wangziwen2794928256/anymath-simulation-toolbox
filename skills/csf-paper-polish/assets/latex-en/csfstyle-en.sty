\csname csf@venue@\csf@venue\endcsname

% --------------------------------------------------------------------------- %
% APPLY: geometry.
%
% THE DOUBLE \expandafter IS LOAD-BEARING, not decoration.
%
% geometry's key parser splits its argument on commas at the TOKEN level and does
% not expand it first. Writing the obvious
%     \geometry{\csf@geometry}
% therefore hands the parser a single token, which it treats as ONE key named
% `letterpaper,textwidth=5.5in,...`, and it fails with
%     ! Package keyval Error: letterpaper,textwidth=5.5in,... undefined.
% The failure is not fatal, so the document still compiles and a first glance at the
% PDF looks plausible — but EVERY preset dimension is discarded and the body falls
% back to the article class default (6.5in on letterpaper instead of 5.5in). Half of
% what makes the shell look like the target venue silently disappears.
% The idiom below expands the macro before the parser sees it.
% --------------------------------------------------------------------------- %
\expandafter\geometry\expandafter{\csf@geometry}
% A two-column venue compiled single-column produces a very wide measure at the
% single-column font size, which looks wrong in a way that is hard to diagnose
% from the log; say so explicitly instead.
\if@twocolumn\else
  \ifnum\csf@twocolreq=1
    \PackageWarning{csfstyle-en}{Venue `\csf@venue' is a TWO-column style;
      add [twocolumn] to \string\documentclass\space or the measure will be wrong}%
  \fi
\fi

% --------------------------------------------------------------------------- %
% Microtype. Protrusion and expansion are the largest single "professionally
% typeset" lever available: they remove the loose lines and rivers that justified
% 10pt Times produces. Expansion needs LuaTeX; under XeLaTeX microtype silently
% drops it, so say so rather than letting the author wonder why the lines look
% worse than expected.
%
% microtype's `kerning` feature is NOT enabled: under LuaTeX it raises
%   "Package microtype Error: The kerning feature only works with pdftex"
% and aborts the run.
% --------------------------------------------------------------------------- %
\RequirePackage{microtype}
\ifLuaTeX
  \microtypesetup{protrusion=true, expansion=true, tracking=true}
\else
  \microtypesetup{protrusion=true, expansion=false, tracking=true}
  \PackageWarning{csfstyle-en}{Compiling with XeLaTeX: microtype font expansion
    is unavailable. Use lualatex for the final appearance pass}%
\fi

% --------------------------------------------------------------------------- %
% Page-breaking discipline. Contest templates rarely set these, and the resulting
% stranded lines are a page-level quality gap that readers notice without being
% able to name. [official] neurips_2025.sty:130-133.
% --------------------------------------------------------------------------- %
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
\predisplaypenalty=10000
\setlength{\emergencystretch}{2em}
\csf@bottom

% Float placement fractions, taken from the venue where defined.
\renewcommand{\topfraction}{\csf@topfraction}
\renewcommand{\bottomfraction}{\csf@bottomfraction}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.7}

% --------------------------------------------------------------------------- %
% APPLY: paragraph style and headings.
%
% Case is authorial — write sentence case in the source. The shell must NOT
% auto-uppercase or auto-title-case, because automatic casing destroys acronyms
% ("MAPPO" becomes "Mappo") and is a visible defect.
% --------------------------------------------------------------------------- %
\setlength{\parindent}{\csf@parindent}
\setlength{\parskip}{\csf@parskip}

\RequirePackage{titlesec}

% Unnumbered venues (aaai, nature) must not leave the label's separator space
% behind, so the label and its separator are macros rather than literals.
\def\csf@seclabel{\thesection}
\def\csf@secsep{0.6em}
\def\csf@sublabel{\thesubsection}
\def\csf@subsep{0.5em}
\def\csf@subsublabel{\thesubsubsection}
\def\csf@subsubsep{0.5em}
\ifnum\csf@secdepth=0
  \def\csf@seclabel{}%
  \def\csf@secsep{0pt}%
  \def\csf@sublabel{}%
  \def\csf@subsep{0pt}%
  % subsubsection needs the same treatment: its titleformat names \thesubsubsection
  % explicitly, and that macro still expands to "0.0.1" even when secnumdepth is 0.
  \def\csf@subsublabel{}%
  \def\csf@subsubsep{0pt}%
\fi
\setcounter{secnumdepth}{\csf@secdepth}

\titleformat{\section}{\normalfont\csf@secfmt}{\csf@seclabel}{\csf@secsep}{}
\titleformat{\subsection}{\normalfont\csf@subsecfmt}{\csf@sublabel}{\csf@subsep}{}
\titleformat{\subsubsection}{\normalfont\csf@subsubfmt}{\csf@subsublabel}{\csf@subsubsep}{}
% Run-in bold paragraph headings: the standard way to label a design rationale
% without spending a numbered level on it, and much tighter than a subsubsection.
%
% NO automatic trailing period. An earlier version appended one via the optional
% after-code and produced "Design rationale.." whenever the author had also
% written the period — a defect that survived two readings of the compiled page.
% The convention is the standard LaTeX one: the author writes the period, and
% csf_prose.py checks that the style is applied consistently.
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{}{0pt}{}

% Official @startsection uses a negative before-skip to disable indentation;
% titlesec uses the sign as actual vertical space. Transfer the magnitude.
\newskip\csf@sectionbefore
\newskip\csf@subsectionbefore
\newskip\csf@subsubsectionbefore
\csf@sectionbefore=\csf@secbefore\relax
\csf@subsectionbefore=\csf@subbefore\relax
\csf@subsubsectionbefore=\csf@subsubbefore\relax
\ifdim\csf@sectionbefore<0pt \multiply\csf@sectionbefore by -1\fi
\ifdim\csf@subsectionbefore<0pt \multiply\csf@subsectionbefore by -1\fi
\ifdim\csf@subsubsectionbefore<0pt \multiply\csf@subsubsectionbefore by -1\fi
\titlespacing*{\section}{0pt}{\csf@sectionbefore}{\csf@secafter}
\titlespacing*{\subsection}{0pt}{\csf@subsectionbefore}{\csf@subafter}
\titlespacing*{\subsubsection}{0pt}{\csf@subsubsectionbefore}{\csf@subsubafter}
\titlespacing*{\paragraph}{0pt}{0.8ex plus .2ex minus .2ex}{0.5em}

% --------------------------------------------------------------------------- %
% Captions. Labels and separators differ per venue by design:
%   neurips  bold label, period        (approx; the official file is silent)
%   icml     slanted label, period, short captions CENTRED, long body footnotesize
%   aaai     roman, unemphasised, 10pt (AAAI states this explicitly)
%   aamas    bold label, COLON — the ACM house style
% Tables above, figures below — universal except AAAI's instructions, which ask
% for both below, contradicting its own class default.
% --------------------------------------------------------------------------- %
\RequirePackage{caption}
% LABEL FORMATS ARE DECLARED EXPLICITLY, not routed through the `labelfont` key.
%
% Empirical finding, and the reason this block looks the way it does: passing a
% font list to `labelfont` — `labelfont={\slshape,\small}` — produced a caption
% label that was INDISTINGUISHABLE from the body text. The slanted emphasis never
% appeared, and nothing warned: `labelsep` from the same option set applied fine,
% so the option set itself was live and only the font list was silently dropped.
% `\textsl` elsewhere in the same document rendered correctly, which ruled out the
% font and pointed at the key's value parsing.
%
% `\DeclareCaptionLabelFormat` takes literal code, so the emphasis, the size and
% the separator are all under direct control and cannot be reinterpreted. The
% formats are declared once here and selected per venue by
% `\csf@captionlabelformat`; `\csf@labelemph` and `\csf@captionlabelfontsize` carry
% the venue's emphasis and label size.
\DeclareCaptionLabelFormat{csfperiod}{{\csf@captionlabelfontsize\csf@labelemph #1~#2.}}
\DeclareCaptionLabelFormat{csfcolon}{{\csf@captionlabelfontsize\csf@labelemph #1~#2:}}
\captionsetup{
  font            = \csf@captionfont,
  labelformat     = \csf@captionlabelformat,
  labelsep        = quad,
  justification   = \csf@captionjust,
  singlelinecheck = \csf@captioncenter,
  skip            = 5pt,
}
\captionsetup[table]{position=top, skip=4pt}
\captionsetup[figure]{position=bottom, skip=5pt}
\RequirePackage{subcaption}
\captionsetup[sub]{font=small, labelfont=bf, labelsep=space}

% --------------------------------------------------------------------------- %
% Tables. booktabs everywhere; vertical rules and doubled rules are the clearest
% "not typeset professionally" signal in a results table. siunitx supplies
% decimal-aligned numeric columns, which readers use to compare magnitudes and
% which hand-aligned tables reliably get wrong.
%
% NOTE: round-mode is deliberately NOT enabled. Silently rounding a number that
% came out of an experiment is data corruption, however tidy it looks.
% --------------------------------------------------------------------------- %
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{siunitx}
\RequirePackage{array}
\renewcommand{\arraystretch}{1.12}
\setlength{\tabcolsep}{5pt}
\sisetup{
  detect-weight          = true,
  detect-family          = true,
  table-number-alignment = center,
  group-separator        = {\,},
}
\newcolumntype{B}{S[table-format=3.2]}   % 3 integer digits, 2 decimals
\newcolumntype{C}{S[table-format=2.2]}
\newcolumntype{D}{S[table-format=1.3]}

% --------------------------------------------------------------------------- %
% Lists. Deep bullet nesting is where contest drafts get ugly. [official]
% neurips_2025.sty:232-241 topsep 4pt, itemsep 2pt, leftmargin 3pc.
% --------------------------------------------------------------------------- %
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=\csf@listmargin, topsep=2pt, itemsep=1.5pt, parsep=0pt}
\setlist[enumerate]{leftmargin=\csf@listmargin, topsep=2pt, itemsep=1.5pt, parsep=0pt}
% Manual "C1." labels so a reviewer can cite a contribution by name.
\newlist{csfcontribs}{enumerate}{1}
\setlist[csfcontribs]{label=\textbf{C\arabic*.}, leftmargin=2.2em, topsep=3pt,
                      itemsep=2pt, parsep=0pt}

% --------------------------------------------------------------------------- %
% Theorem-like environments, named for what a simulation paper actually needs
% (Assumption / Proposition / Lemma / Definition / Remark) rather than the
% mathematics default of Theorem-first.
% --------------------------------------------------------------------------- %
\RequirePackage{amsthm}
\theoremstyle{plain}
\newtheorem{csfproposition}{Proposition}
\newtheorem{csflemma}{Lemma}
\theoremstyle{definition}
\newtheorem{csfdefinition}{Definition}
\newtheorem{csfassumption}{Assumption}
\theoremstyle{remark}
\newtheorem{csfremark}{Remark}
\renewcommand{\proofname}{Proof}

% --------------------------------------------------------------------------- %
% Semantic boxes.
%
% DESIGN WARNING, learned from the earlier Chinese shell: heavy coloured boxes
% with rounded corners are themselves a contest-paper marker. Top venues put this
% content in ordinary prose. So the DEFAULT is plain — a thin left rule and no
% fill, which reads as a page-level pull-quote rather than as decoration. The
% `boxes` option (soft tints) exists for internal drafts where you want to find
% the blocks fast. Style names carry a `csfbx` prefix so they cannot collide with
% the environment names.
% --------------------------------------------------------------------------- %
\RequirePackage[most]{tcolorbox}

\tcbset{
  csfbase/.style={
    enhanced, breakable,
    boxrule=0pt, leftrule=1.6pt,
    arc=0mm, outer arc=0mm,
    left=6pt, right=4pt, top=3pt, bottom=3pt,
    fonttitle=\bfseries\small,
    coltitle=csfInk,
    % `before skip` / `after skip` are LOAD-BEARING, not cosmetic.
    %
    % Keep visible separation around callout boxes. Heading before-skips from
    % official @startsection presets are converted to positive magnitudes for
    % titlesec above; their negative sign originally controlled indentation.
    before skip = 8pt,
    after skip  = 16pt,
    % A `breakable` box that splits across a column or page break gets NO padding at
    % the break point by default, so the continuation starts flush against the rule
    % and the next heading lands hard against the last line. `pad at break*` adds
    % the breathing room at the break itself — which `after skip` cannot do, because
    % `after skip` only applies where the box finally ENDS.
    pad at break* = 6pt,
    attach boxed title to top left={xshift=3pt, yshift=-1pt},
    boxed title style={boxrule=0pt, arc=0mm, left=3pt, right=3pt,
                       top=0pt, bottom=0pt},
  }
}

\ifcsf@tinted
  \tcbset{
    csfbxcontrib/.style={csfbase, colback=csfTint, colframe=csfOurs,
                         colbacktitle=csfTint},
    csfbxkey/.style={csfbase, colback=csfTint, colframe=csfImprove,
                     colbacktitle=csfTint},
    csfbxasm/.style={csfbase, colback=csfTint, colframe=csfReference,
                     colbacktitle=csfTint},
    csfbxtake/.style={csfbase, colback=csfTint, colframe=csfOursAlt,
                      colbacktitle=csfTint},
    csfbxlimit/.style={csfbase, colback=csfTintWarn, colframe=csfBottleneck,
                       colbacktitle=csfTintWarn},
    csfbxmethod/.style={csfbase, colback=white, colframe=csfBaseline,
                        colbacktitle=white},
  }
\else
  \tcbset{
    csfbxcontrib/.style={csfbase, colback=white, colframe=csfOurs,
                         colbacktitle=white},
    csfbxkey/.style={csfbase, colback=white, colframe=csfImprove,
                     colbacktitle=white},
    csfbxasm/.style={csfbase, colback=white, colframe=csfReference,
                     colbacktitle=white},
    csfbxtake/.style={csfbase, colback=white, colframe=csfOursAlt,
                      colbacktitle=white},
    csfbxlimit/.style={csfbase, colback=white, colframe=csfBottleneck,
                       colbacktitle=white},
    csfbxmethod/.style={csfbase, colback=white, colframe=csfBaseline,
                        colbacktitle=white},
  }
\fi

\newtcolorbox{csfcontrib}[1][Contributions]{csfbxcontrib, title={#1}}
\newtcolorbox{csfkey}[1][Key result]{csfbxkey, title={#1}}
\newtcolorbox{csfasm}[1][Assumptions]{csfbxasm, title={#1}}
\newtcolorbox{csftake}[1][Takeaway]{csfbxtake, title={#1}}
\newtcolorbox{csflimit}[1][Limitations]{csfbxlimit, title={#1}}
\newtcolorbox{csfmethod}[1][Method]{csfbxmethod, title={#1}}

% --------------------------------------------------------------------------- %
% Figure placeholder.
%
% The art is produced separately (and in this project, redrawn in vector software
% by hand). Two things must nevertheless be final BEFORE the art exists: the space
% the figure occupies, and the caption. Otherwise the line breaking, the page
% count and the caption length all change once the art lands and the text has to
% be rewritten. This placeholder occupies the exact final size and carries the
% caption, so the layout is frozen early.
%
% API: \csffigplaceholder[<width>]{<height>}   (width defaults to \linewidth)
%
% The width is an OPTIONAL argument and is never TYPESET. That is deliberate: a
% dimen register such as \linewidth is illegal in horizontal text mode and raises
%   "Missing number, treated as zero" + "Illegal unit of measure (pt inserted)"
% the moment it is printed. Only the height — always a literal like 4.2cm — is
% shown.
% --------------------------------------------------------------------------- %
\providecommand{\csffigplaceholder}[2][\linewidth]{%
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \fcolorbox{csfGrid}{white}{%
    % Subtract the two frame rules, otherwise the box is 0.8pt wider than the
    % text block and LaTeX reports an Overfull \hbox.
    \parbox[c][#2][c]{\dimexpr#1-2\fboxrule\relax}{%
      \centering\small\color{csfBaseline}%
      figure placeholder\\[0.25em]%
      \footnotesize height #2 --- supply vector art}}%
  \endgroup}

% --------------------------------------------------------------------------- %
% Claim / evidence binding.
%
% The recurring failure is not "no figure" but "a figure no sentence needs": a
% panel is included for completeness and no claim depends on it. The fix is to
% make the dependency explicit IN THE SOURCE, where a script can verify it:
%
%   \csfclaim{C3}{Capacity-proportional allocation cuts mean clearance time.}%
%   \csfevi{fig:main,tab:main}
%
% In draft mode both are printed inline, so the author sees the coupling while
% writing and uncovered claims stand out. In final mode both vanish, leaving clean
% prose. csf_prose.py parses the source in either mode.
% --------------------------------------------------------------------------- %
\providecommand{\csfclaim}[2]{%
  \ifcsf@draft\textsuperscript{\textcolor{csfLink}{[#1]}}#2\else#2\fi}
\providecommand{\csfevi}[1]{%
  \ifcsf@draft\,{\footnotesize\textcolor{csfLink}{$\rightarrow$\,#1}}\fi}

% --------------------------------------------------------------------------- %
% Result-table emphasis. Bolding the best value is only meaningful when the
% selection rule is stated in the caption ("bold = within one standard deviation
% of the best"). These macros keep that rule out of the numbers themselves.
% --------------------------------------------------------------------------- %
\providecommand{\best}[1]{\textbf{#1}}
\providecommand{\second}[1]{\underline{#1}}
\providecommand{\ours}[1]{\textcolor{csfOurs}{\textbf{#1}}}
\providecommand{\naref}{\textnormal{N/A}}

% --------------------------------------------------------------------------- %
% Prose macros: the micro-typography that separates a typeset paper from a
% word-processed one — upright Latin abbreviations, non-breaking spaces, dashes.
% --------------------------------------------------------------------------- %
\RequirePackage{xspace}
\providecommand{\eg}{e.g.,\xspace}
\providecommand{\ie}{i.e.,\xspace}
\providecommand{\etal}{et~al.\xspace}
\providecommand{\cf}{cf.\@\xspace}
\providecommand{\wrt}{w.r.t.\@\xspace}
\providecommand{\code}[1]{\texttt{#1}}

% --------------------------------------------------------------------------- %
% Abstract. The official venues set the abstract in a NARROWER measure than the
% body via a `quote` environment, and keep the body at NORMAL size. An earlier
% version of this shell used \small, which both lightened the block and diverged
% from every official file.
% --------------------------------------------------------------------------- %
\providecommand{\csfkeywordsname}{Keywords}
\providecommand{\csfkeywords}[1]{%
  \par\vspace{0.5em}\noindent
  {\bfseries\csfkeywordsname:}~#1\par}

\newenvironment{csfabstract}{%
  \par\vspace{0.9em}%
  \begin{center}{\csf@abstractheadfmt Abstract}\end{center}%
  \vspace{0.3ex}%
  \ifnum\csf@abstractquote=1
    \begin{quote}%
  \else
    % A bare `list` demands an \item before any content; without it LaTeX aborts
    % with "Something's wrong--perhaps a missing \item" at \end{csfabstract}.
    % `quote` supplies its own \item, which is why only this branch needs one.
    \begin{list}{}{%
      \setlength{\leftmargin}{0.05\linewidth}%
      \setlength{\rightmargin}{0.05\linewidth}%
      \setlength{\listparindent}{0pt}%
      \setlength{\topsep}{0.3em}%
      \setlength{\parsep}{0pt}}%
    \item\relax
  \fi
  \csf@abstractsize
}{%
  \ifnum\csf@abstractquote=1\end{quote}\else\end{list}\fi
  \vspace{0.6em}%
}

% --------------------------------------------------------------------------- %
% Title block, written as macros rather than \maketitle: contest classes inject
% their own cover page, whereas a top-venue title block is a tight centred block
% and nothing else. [official] neurips_2025.sty:290-332 wraps the title in a 4pt
% rule above and a 1pt rule below, separated by 0.25in / 0.29in — a recognisable
% signature of the venue, so it is reproduced when the preset asks for it.
%
% \suppressfloats[t] IS LOAD-BEARING. A `[t]` float declared in the body of page 1
% is placed in the top float area, which sits ABOVE the title block, so without
% this the first table or figure appears over the paper title. The official classes
% avoid it because \maketitle runs before the first page's float queue is built;
% here the title is an ordinary block, so the suppression has to be explicit.
% Real papers show the same behaviour: page 1 carries title, abstract and text, and
% the first top float appears on page 2.
% --------------------------------------------------------------------------- %
\providecommand{\csftitle}[1]{%
  \par\vspace{0.4em}%
  \ifnum\csf@titlebars=1
    \begingroup\noindent\rule{\linewidth}{4pt}\par\vspace{0.25in}\endgroup
  \fi
  \begin{center}{\csf@titlefmt #1\par}\end{center}%
  \ifnum\csf@titlebars=1
    \begingroup\vspace{0.29in}\noindent\rule{\linewidth}{1pt}\par
    \vspace{0.09in}\endgroup
  \fi
  \vspace{0.1em}%
  \suppressfloats[t]}
\providecommand{\csfauthors}[1]{%
  \begin{center}\csf@authorfmt #1\end{center}\vspace{0.1em}}
\providecommand{\csfaffil}[1]{%
  \begin{center}\small\itshape #1\end{center}\vspace{0.2em}}
\providecommand{\csfemail}[1]{%
  \begin{center}\small #1\end{center}\vspace{0.4em}}
% Nature-style standfirst: one sentence, larger and sans, that states the result
% rather than the topic. Optional; omit for conference venues.
\providecommand{\csfstandfirst}[1]{%
  \begin{center}\normalsize\sffamily #1\end{center}\vspace{0.3em}}

% --------------------------------------------------------------------------- %
% Cross-references. cleveref must load AFTER hyperref. `nameinlink` makes the
% whole "Figure 3" clickable, and `capitalise` guarantees a capital at sentence
% start without hand-editing the source.
% --------------------------------------------------------------------------- %
\RequirePackage{hyperref}
\ifcsf@print
  \hypersetup{hidelinks}
\else
  \hypersetup{
    colorlinks = true,
    linkcolor  = csfLink,
    citecolor  = csfLink,
    urlcolor   = csfLink,
    filecolor  = csfLink,
    pdfborder  = {0 0 0},
  }
\fi
\RequirePackage[capitalise,noabbrev,nameinlink]{cleveref}
\crefname{figure}{Figure}{Figures}
\crefname{table}{Table}{Tables}
\crefname{section}{Sec.}{Secs.}
\crefname{equation}{Eq.}{Eqs.}
% These counter names must match the \newtheorem names above. Mapping cleveref to
% `assumption` while the counter is `csfassumption` silently prints "??" — the
% same class of mismatch that produced the earlier `KeyError: '方法'`.
\crefname{csfassumption}{Assumption}{Assumptions}
\crefname{csfproposition}{Proposition}{Propositions}
\crefname{csflemma}{Lemma}{Lemmas}
\crefname{csfdefinition}{Definition}{Definitions}
\crefname{csfremark}{Remark}{Remarks}

% --------------------------------------------------------------------------- %
% Draft extras: line numbers for review. lineno is incompatible with two columns,
% so it is enabled only when single-column.
% --------------------------------------------------------------------------- %
\ifcsf@draft
  \if@twocolumn\else
    \RequirePackage[mathlines,switch]{lineno}
    \linenumbers
  \fi
\fi

% --------------------------------------------------------------------------- %
% Header/footer: a page number and nothing else. Running titles belong to the
% camera-ready, not to the copy a reviewer annotates.
% --------------------------------------------------------------------------- %
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}

% --------------------------------------------------------------------------- %
% Back-matter statements (Reproducibility, Compute, Ethics, Impact). Rendered as
% unnumbered bold run-in headings so they do not pollute section numbering.
% --------------------------------------------------------------------------- %
\providecommand{\csfstatement}[1]{%
  \par\vspace{0.9em}\noindent{\bfseries #1}\par\nobreak\vspace{0.15em}}

% --------------------------------------------------------------------------- %
% Algorithms: ruled, vlined, numbered. The Chinese shell's 输入/输出 keywords are
% replaced with English ones — a half-translated artefact reads as carelessness,
% and algorithm keywords are exactly where it happens.
% --------------------------------------------------------------------------- %
\providecommand{\algoref}[1]{Algorithm~#1}
\IfFileExists{algorithm2e.sty}{%
  \RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}%
  \SetKwComment{Comment}{// }{}%
  \SetAlgoLined
  \DontPrintSemicolon
  \SetKwInput{KwIn}{Input}%
  \SetKwInput{KwOut}{Output}%
  \SetKwInput{KwData}{Data}%
  \SetKwInput{KwResult}{Result}%
  \SetKw{Return}{return}%
}{}

\endinput
